<!-- Disegno — an apophenic drawing machine.
     Seed an inkblot, ask the eye what it resembles, draw toward it at a fixed
     rate, then re-see and revise within an erasure budget. Repeat.
     Runs as a rendered Claude artifact (the Anthropic API is auto-authenticated there). -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<style>
  :root{
    --ground:#0d1014;        /* studio at night */
    --ground-2:#11151b;
    --paper:#ece4d3;         /* blotting paper */
    --paper-warm:#e4dac4;
    --ink:#1b2733;           /* prussian-charcoal */
    --line:#2b333d;
    --dim:#5d6873;
    --text:#aeb7bf;
    --bright:#e8d9b5;        /* lamplight */
    --accent:#c8643f;        /* dried vermilion, used once */
    --mono: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, Consolas, monospace;
    --serif: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
  }
  *{box-sizing:border-box}
  html,body{margin:0;height:100%}
  body{
    background:
      radial-gradient(120% 90% at 50% -10%, #161b22 0%, var(--ground) 55%, #090b0e 100%);
    color:var(--text); font-family:var(--mono); -webkit-font-smoothing:antialiased;
    display:flex; align-items:stretch; justify-content:center; padding:22px; gap:0;
  }
  .frame{
    width:100%; max-width:1080px; display:grid;
    grid-template-columns: minmax(0,1fr) 320px; gap:26px; align-items:start;
  }
  header.title{ grid-column:1 / -1; display:flex; align-items:baseline; gap:14px; flex-wrap:wrap; margin-bottom:2px;}
  header.title h1{
    font-family:var(--serif); font-weight:500; font-style:italic;
    font-size:30px; letter-spacing:.3px; color:var(--bright); margin:0;
  }
  header.title .sub{ font-size:11px; letter-spacing:.18em; text-transform:uppercase; color:var(--dim);}

  /* ---- the plate ---- */
  .plate-wrap{ position:relative; }
  .plate{
    position:relative; aspect-ratio:1/1; border-radius:2px;
    background:var(--paper);
    box-shadow: 0 1px 0 #ffffff22 inset, 0 0 0 1px #000 , 0 26px 50px -18px #000c, 0 2px 0 #00000055;
    overflow:hidden;
  }
  .plate canvas{ position:absolute; inset:0; width:100%; height:100%; display:block; }
  .deckle{ position:absolute; inset:0; pointer-events:none; box-shadow: inset 0 0 38px #0002, inset 0 0 4px #0003;}
  .phase{
    position:absolute; left:10px; bottom:9px; z-index:3; display:flex; align-items:center; gap:8px;
    font-size:10.5px; letter-spacing:.16em; text-transform:uppercase; color:#5a5036;
    background:#ece4d3cc; padding:4px 8px; border-radius:2px; backdrop-filter:blur(2px);
  }
  .metro{ width:7px; height:7px; border-radius:50%; background:#7c6f49; opacity:.35;}
  .metro.beat{ animation: tick var(--beat,500ms) linear infinite; }
  @keyframes tick{ 0%{transform:scale(1);opacity:.9} 40%{opacity:.25} 100%{transform:scale(1.6);opacity:0} }

  /* ---- side: the drift ---- */
  aside{ display:flex; flex-direction:column; gap:16px; min-height:0;}
  .panel{ border:1px solid var(--line); border-radius:3px; background:linear-gradient(180deg,var(--ground-2),#0c1015); }
  .panel h2{ font-size:10px; letter-spacing:.2em; text-transform:uppercase; color:var(--dim);
    margin:0; padding:11px 13px; border-bottom:1px solid var(--line);}

  .seed-body{ padding:12px; display:flex; gap:12px; align-items:flex-start;}
  .seed-thumb{ width:96px; height:96px; flex:none; border-radius:2px; background:var(--paper);
    box-shadow:0 0 0 1px #000, 0 6px 14px -6px #000a; object-fit:cover;}
  .seed-cap{ font-size:11px; color:var(--dim); line-height:1.5;}
  .seed-cap b{ color:var(--text); font-weight:500; font-style:normal;}
  .drift{ padding:6px 0 8px; max-height:300px; overflow:auto; position:relative; }
  .drift::-webkit-scrollbar{width:8px} .drift::-webkit-scrollbar-thumb{background:#1c232b;border-radius:8px}
  .entry{ position:relative; padding:7px 14px 7px 30px; }
  .entry::before{ content:""; position:absolute; left:15px; top:0; bottom:0; width:1px; background:var(--line);}
  .entry .node{ position:absolute; left:11px; top:12px; width:9px; height:9px; border-radius:50%;
    background:var(--ground); border:1px solid var(--dim);}
  .entry .meta{ font-size:9.5px; color:var(--dim); letter-spacing:.08em; }
  .entry .seen{ color:var(--text); font-size:13.5px; line-height:1.35; margin-top:2px;}
  .entry .note{ color:var(--dim); font-size:11px; font-style:italic; margin-top:3px; }
  .entry.live .node{ background:var(--accent); border-color:var(--accent); box-shadow:0 0 0 4px #c8643f22;
    animation:breathe 1.6s ease-in-out infinite;}
  .entry.live .seen{ color:var(--bright); }
  @keyframes breathe{ 50%{ box-shadow:0 0 0 7px #c8643f10 } }

  /* ---- controls ---- */
  .controls{ padding:13px; display:flex; flex-direction:column; gap:13px;}
  .row{ display:flex; align-items:center; justify-content:space-between; gap:10px;}
  .row label{ font-size:11px; color:var(--text); letter-spacing:.04em;}
  .row .val{ font-size:11px; color:var(--bright); min-width:54px; text-align:right;}
  input[type=range]{ -webkit-appearance:none; appearance:none; height:2px; background:var(--line); flex:1; border-radius:2px;}
  input[type=range]::-webkit-slider-thumb{ -webkit-appearance:none; width:13px;height:13px;border-radius:50%;
    background:var(--bright); cursor:pointer; border:2px solid var(--ground);}
  input[type=range]::-moz-range-thumb{ width:13px;height:13px;border-radius:50%; background:var(--bright); cursor:pointer; border:2px solid var(--ground);}
  .buttons{ display:flex; gap:9px; }
  button{ font-family:var(--mono); flex:1; padding:10px; font-size:11px; letter-spacing:.12em; text-transform:uppercase;
    border:1px solid var(--line); background:#10151b; color:var(--text); border-radius:3px; cursor:pointer; transition:.15s;}
  button:hover{ border-color:var(--dim); color:var(--bright);}
  button.primary{ background:var(--accent); border-color:var(--accent); color:#1a0e08; font-weight:600;}
  button.primary:hover{ filter:brightness(1.08); color:#1a0e08;}
  button:disabled{ opacity:.4; cursor:default;}
  .err{ color:var(--accent); font-size:11px; padding:0 13px 12px; line-height:1.4; display:none;}
  .log{ color:var(--dim); font-size:10.5px; padding:0 13px 12px; line-height:1.5; word-break:break-word; font-feature-settings:"tnum";}
  .toggle{ display:flex; align-items:center; gap:8px; font-size:11px; color:var(--text); cursor:pointer; user-select:none;}
  .toggle input{ accent-color:var(--accent); width:14px; height:14px;}
  .keyin{ width:100%; background:#0b0f14; border:1px solid var(--line); border-radius:3px; color:var(--text);
    font-family:var(--mono); font-size:11px; padding:8px 9px; outline:none;}
  .keyin:focus{ border-color:var(--dim);}
  .keyin::placeholder{ color:#4a535d;}
  @media (max-width:840px){ .frame{grid-template-columns:1fr} aside{order:2} }
  @media (prefers-reduced-motion: reduce){ *{animation:none!important} }
</style>

<div class="frame">
  <header class="title">
    <h1>Disegno</h1>
    <span class="sub">apophenia in charcoal</span>
  </header>

  <div class="plate-wrap">
    <div class="plate">
      <canvas id="plate"></canvas>
      <div class="deckle"></div>
      <div class="phase"><span class="metro" id="metro"></span><span id="phase">idle</span></div>
    </div>
  </div>

  <aside>
    <div class="panel">
      <h2>The seed &mdash; read, not drawn</h2>
      <div class="seed-body">
        <img id="seedImg" class="seed-thumb" alt="the asymmetric ink-stain stimulus">
        <div class="seed-cap">The chance stain the eye reads first. It <b>never touches the paper</b> &mdash; the drawing is whatever the mind makes of it. After the first pass, the eye reads the drawing itself.</div>
      </div>
    </div>
    <div class="panel">
      <h2>The drift &mdash; what the eye resolves</h2>
      <div class="drift" id="drift"></div>
    </div>
    <div class="panel">
      <h2>The rule</h2>
      <div class="controls">
        <div class="row"><label>Drawing rate</label>
          <input id="rate" type="range" min="2" max="30" step="1" value="9"><span class="val" id="rateV">9 / s</span></div>
        <div class="row"><label>Time per pass</label>
          <input id="time" type="range" min="2" max="14" step="1" value="6"><span class="val" id="timeV">6 s</span></div>
        <div class="row"><label>Reveal (lift)</label>
          <input id="erase" type="range" min="0" max="40" step="2" value="16"><span class="val" id="eraseV">16 %</span></div>
        <div class="row"><label>Passes</label>
          <input id="passes" type="range" min="3" max="24" step="1" value="8"><span class="val" id="passesV">8</span></div>
        <label class="toggle"><input type="checkbox" id="offline"> draw without the model (offline)</label>
        <div class="buttons">
          <button id="run" class="primary">Begin</button>
          <button id="seed">New blot</button>
        </div>
      </div>
      <div class="err" id="err"></div>
      <div class="log" id="log">idle</div>
    </div>
  </aside>
</div>

<script>
const $ = s => document.querySelector(s);
const cvs = $('#plate'), ctx = cvs.getContext('2d');
const PAPER = getComputedStyle(document.documentElement).getPropertyValue('--paper').trim();
const INK = getComputedStyle(document.documentElement).getPropertyValue('--ink').trim();
const CHAR_RGB = '40,44,52';        // charcoal
const PAPER_RGB = '236,228,211';    // for lifting toward light

let DPR = Math.min(2, window.devicePixelRatio || 1);
let S = 0; // plate size in CSS px
function sizeCanvas(){
  const r = cvs.getBoundingClientRect();
  S = r.width || cvs.clientWidth || (cvs.parentElement && cvs.parentElement.clientWidth) || 0;
  if(S < 2){ requestAnimationFrame(()=>{ if(!round) blankPaper(); }); return false; }
  cvs.width = Math.round(S*DPR); cvs.height = Math.round(S*DPR);
  ctx.setTransform(DPR,0,0,DPR,0,0);
  return true;
}

// ---------- state ----------
let running = false, round = 0, abortToken = 0;
let subject = null, perceptMemory = [];   // coherence: commit to one subject, develop it
const params = ()=>({
  rate:+$('#rate').value, time:+$('#time').value, erase:+$('#erase').value/100,
  passes:+$('#passes').value
});

// ---------- the Rorschach seed ----------
let stimulusB64 = null;   // the off-paper stain the eye reads at the start
let stimCanvas = null;    // kept offscreen so the offline hand can sample its shape

// An asymmetric ink stain — Leonardo's stain on the wall. Rendered OFF the paper:
// it is what the eye reads, never a mark on the drawing itself.
function newStimulus(){
  const n=512, off=document.createElement('canvas'); off.width=n; off.height=n;
  const o=off.getContext('2d');
  o.fillStyle=PAPER; o.fillRect(0,0,n,n);
  for(let i=0;i<n*1.2;i++){ o.fillStyle=`rgba(60,50,30,${Math.random()*0.04})`; o.fillRect(Math.random()*n,Math.random()*n,1,1); }
  // blobs clustered around a wandering centroid -> coherent but irregular, no symmetry
  let cx=n*(0.35+Math.random()*0.3), cy=n*(0.35+Math.random()*0.3);
  const blobs=7+(Math.random()*6|0);
  for(let i=0;i<blobs;i++){
    cx+=(Math.random()-0.5)*n*0.22; cy+=(Math.random()-0.5)*n*0.22;
    cx=Math.max(n*0.12,Math.min(n*0.88,cx)); cy=Math.max(n*0.12,Math.min(n*0.88,cy));
    const rad=n*(0.05+Math.random()*0.17), a=0.5+Math.random()*0.45;
    const g=o.createRadialGradient(cx,cy,0,cx,cy,rad);
    g.addColorStop(0,`rgba(20,28,38,${a})`); g.addColorStop(0.55,`rgba(20,28,38,${a*0.5})`); g.addColorStop(1,'rgba(20,28,38,0)');
    o.fillStyle=g; o.beginPath(); o.arc(cx,cy,rad,0,7); o.fill();
    o.strokeStyle=`rgba(18,25,34,${a*0.7})`; o.lineWidth=1+Math.random()*3; o.lineCap='round';
    o.beginPath(); o.moveTo(cx,cy); let x=cx,y=cy;
    for(let k=0;k<5;k++){ x+=(Math.random()-0.5)*rad*1.4; y+=(Math.random()-0.5)*rad*1.4; o.lineTo(x,y);} o.stroke();
  }
  const url=off.toDataURL('image/png');
  stimulusB64=url.split(',')[1];
  stimCanvas=off;
  const si=document.getElementById('seedImg'); if(si) si.src=url;
}

// ---------- charcoal ----------
// A soft, grainy dab — the atom of tone. col is "r,g,b", a is opacity.
function dab(x,y,rad,col,a){
  const g=ctx.createRadialGradient(x,y,0,x,y,rad);
  g.addColorStop(0,`rgba(${col},${a})`); g.addColorStop(0.6,`rgba(${col},${a*0.45})`); g.addColorStop(1,`rgba(${col},0)`);
  ctx.fillStyle=g; ctx.beginPath(); ctx.arc(x,y,rad,0,7); ctx.fill();
  for(let i=0;i<rad*0.35;i++){ const t=Math.random()*7, rr=Math.random()*rad;
    ctx.fillStyle=`rgba(${col},${a*Math.random()*0.4})`; ctx.fillRect(x+Math.cos(t)*rr,y+Math.sin(t)*rr,1,1); }
}
// A toned grey ground to carve — not blank, so light can be lifted out of it.
function blankPaper(){
  if(!sizeCanvas()) return;
  ctx.fillStyle=PAPER; ctx.fillRect(0,0,S,S);
  for(let i=0;i<34;i++) dab(Math.random()*S, Math.random()*S, S*(0.25+Math.random()*0.4), CHAR_RGB, 0.05);
  const vg=ctx.createRadialGradient(S/2,S/2,S*0.2,S/2,S/2,S*0.78);
  vg.addColorStop(0,`rgba(${CHAR_RGB},0)`); vg.addColorStop(1,`rgba(${CHAR_RGB},0.13)`);
  ctx.fillStyle=vg; ctx.fillRect(0,0,S,S);
  for(let i=0;i<S*1.3;i++){ ctx.fillStyle=`rgba(${CHAR_RGB},${Math.random()*0.03})`; ctx.fillRect(Math.random()*S,Math.random()*S,1,1); }
}
// Blend/smudge a circular region (a stump or fingertip).
function blendRegion(cx,cy,r){
  const g=document.createElement('canvas'); g.width=S; g.height=S;
  g.getContext('2d').drawImage(cvs,0,0,S,S);
  ctx.save(); ctx.beginPath(); ctx.arc(cx,cy,r,0,7); ctx.clip();
  ctx.filter='blur(3px)'; ctx.drawImage(g,0,0,S,S); ctx.filter='none'; ctx.restore();
}

// ---------- the image we hand the eye (with grounding grid) ----------
function snapshotForModel(){
  const n=512, g=document.createElement('canvas'); g.width=n; g.height=n;
  const c=g.getContext('2d'); c.drawImage(cvs,0,0,n,n);
  c.strokeStyle='rgba(40,80,120,0.18)'; c.fillStyle='rgba(40,80,120,0.5)';
  c.lineWidth=1; c.font='9px monospace';
  for(let i=0;i<=10;i++){ const p=i*n/10;
    c.beginPath(); c.moveTo(p,0); c.lineTo(p,n); c.moveTo(0,p); c.lineTo(n,p); c.stroke();
    if(i%2===0 && i>0){ c.fillText(i*100, p+1, 9); c.fillText(i*100, 1, p-1);} }
  return g.toDataURL('image/png').split(',')[1];
}
function plainSnapshot(){
  const n=512,g=document.createElement('canvas'); g.width=n;g.height=n;
  g.getContext('2d').drawImage(cvs,0,0,n,n);
  return g.toDataURL('image/png').split(',')[1];
}

// ---------- the eye / the hand (Claude API) ----------
function apiKey(){ const el=$('#key'); return el ? el.value.trim() : ''; }
function apiHeaders(){
  const h={"Content-Type":"application/json","anthropic-version":"2023-06-01"};
  const k=apiKey();
  if(k){ h["x-api-key"]=k; h["anthropic-dangerous-direct-browser-access"]="true"; }
  return h;
}
async function ask(messages, system){
  const res = await fetch("/api/messages",{
    method:"POST", headers:apiHeaders(),
    body:JSON.stringify({ model:"claude-sonnet-4-6", max_tokens:1000, system, messages })
  });
  if(!res.ok){ const b=await res.text().catch(()=> ''); throw new Error("API "+res.status+" "+b.slice(0,120)); }
  const data = await res.json();
  return data.content.filter(b=>b.type==="text").map(b=>b.text).join("\n");
}
async function probeModel(){
  try{
    const r = await fetch("/api/messages",{
      method:"POST", headers:apiHeaders(),
      body:JSON.stringify({model:"claude-sonnet-4-6",max_tokens:16,messages:[{role:"user",content:"reply with: ok"}]})
    });
    if(!r.ok){ const t=await r.text().catch(()=> ''); return {ok:false, why:`HTTP ${r.status} ${t.slice(0,100)}`}; }
    return {ok:true};
  }catch(e){ return {ok:false, why:(e&&e.message)||'blocked (network/CORS)'}; }
}
function parseJSON(t){
  const s=t.replace(/```json|```/g,'').trim();
  const a=s.indexOf('{'), b=s.lastIndexOf('}');
  try{ return JSON.parse(a>=0?s.slice(a,b+1):s); }
  catch(e){ throw new Error('could not read the reply — '+s.slice(0,140)); }
}
const imgBlock = b64 => ({type:"image",source:{type:"base64",media_type:"image/png",data:b64}});

// Accept whatever stroke shape the model returns: {pts,w} | [[x,y]..] | {points:[{x,y}]} | {path:[...]}
function asXY(p){
  if(Array.isArray(p)) return [ +p[0], +p[1] ];
  if(p && typeof p==='object') return [ +(p.x ?? p[0]), +(p.y ?? p[1]) ];
  return null;
}
function normStrokes(plan){
  const raw = plan && (plan.strokes || plan.lines || plan.paths || plan.marks);
  if(!Array.isArray(raw)) return [];
  const out=[];
  for(const s of raw){
    const pts = Array.isArray(s) ? s : (s && (s.pts || s.points || s.path));
    const w = (s && (s.w || s.width)) || 2;
    if(!Array.isArray(pts)) continue;
    const P = pts.map(asXY).filter(p=>p && isFinite(p[0]) && isFinite(p[1]));
    if(P.length) out.push({pts:P, w:+w||2});
  }
  return out;
}
function normErase(plan){
  const raw = plan && plan.erase; if(!Array.isArray(raw)) return [];
  return raw.map(r=> Array.isArray(r) ? r.slice(0,4).map(Number)
        : (r && typeof r==='object') ? [r.x,r.y,r.w,r.h].map(Number) : null)
      .filter(r=> r && r.every(isFinite));
}

// ---------- the offline mind (no network needed) ----------
// Dark-weighted sampling: find where the ink already is.
function darkPoints(src, count){
  try{
    const w=src.width,h=src.height;
    const d=src.getContext('2d').getImageData(0,0,w,h).data, pts=[];
    for(let i=0;i<count*60 && pts.length<count;i++){
      const x=(Math.random()*w)|0, y=(Math.random()*h)|0, o=(y*w+x)*4;
      const lum=(d[o]+d[o+1]+d[o+2])/3, dark=Math.max(0,(225-lum)/225);
      if(Math.random()<dark) pts.push([x/w, y/h]);
    }
    return pts;
  }catch(e){ return []; }
}
function plateDark(count){
  const n=256,g=document.createElement('canvas'); g.width=n; g.height=n;
  g.getContext('2d').drawImage(cvs,0,0,n,n);
  return darkPoints(g,count);
}
function brightPoints(src, count){
  try{
    const w=src.width,h=src.height;
    const d=src.getContext('2d').getImageData(0,0,w,h).data, pts=[];
    for(let i=0;i<count*60 && pts.length<count;i++){
      const x=(Math.random()*w)|0, y=(Math.random()*h)|0, o=(y*w+x)*4;
      const lum=(d[o]+d[o+1]+d[o+2])/3, light=Math.max(0,(lum-160)/95);
      if(Math.random()<light) pts.push([x/w, y/h]);
    }
    return pts;
  }catch(e){ return []; }
}
function plate256(){ const g=document.createElement('canvas'); g.width=256; g.height=256;
  g.getContext('2d').drawImage(cvs,0,0,256,256); return g; }

// Offline tonal hand: deepen where shadow gathers, lift where light catches.
function offlineOps(firstPass, liftBias){
  const src = firstPass ? stimCanvas : plate256();
  const dark = darkPoints(src, 5), light = brightPoints(src, 5);
  const ops=[];
  const d = dark[0] || [0.4+Math.random()*0.2, 0.35+Math.random()*0.3];
  ops.push({op:'deepen', cx:d[0]*1000, cy:d[1]*1000, r:120+Math.random()*150, strength:0.65});
  const l = light[0] || [0.3+Math.random()*0.4, 0.3+Math.random()*0.4];
  ops.push({op:'lift', cx:l[0]*1000, cy:l[1]*1000, r:110+Math.random()*130, strength:0.45+liftBias});
  if(Math.random()<0.3 && dark[1]) ops.push({op:'blend', cx:dark[1][0]*1000, cy:dark[1][1]*1000, r:140});
  return ops;
}

// Accept whatever tonal-op shape the model returns.
function normOps(plan){
  let raw = plan && (plan.ops || plan.moves || plan.tone || plan.strokes);
  if(!Array.isArray(raw)) raw = (plan && plan.op) ? [plan] : [];
  const ok=[];
  for(const o of raw){
    if(!o || typeof o!=='object') continue;
    let op=String(o.op||o.type||o.action||'deepen').toLowerCase();
    op = /lift|eras|light|reveal|white|highlight/.test(op) ? 'lift'
       : /blend|smudge|blur|soften|stump/.test(op) ? 'blend' : 'deepen';
    const reg=o.region||o.area||o;
    const cx=+(reg.cx ?? reg.x ?? (Array.isArray(reg)?reg[0]:undefined));
    const cy=+(reg.cy ?? reg.y ?? (Array.isArray(reg)?reg[1]:undefined));
    if(!isFinite(cx)||!isFinite(cy)) continue;
    let r=+(o.r ?? o.radius ?? reg.r ?? 150); if(!isFinite(r)) r=150;
    let st=+(o.strength ?? o.s ?? o.amount ?? 0.6); if(!isFinite(st)) st=0.6;
    ok.push({op, cx, cy, r, strength:Math.max(0.1,Math.min(1,st))});
  }
  return ok;
}
const OFFLINE_POOL=["a wading bird","a cloaked figure","a windswept tree","a crouching hare",
  "a harbour at dusk","a sleeping hound","a mountain ridge","a dancer mid-turn",
  "a tangle of roots","a face half-seen","a ship's prow","a kneeling angel"];
function offlineSee(subject){ return subject || OFFLINE_POOL[(Math.random()*OFFLINE_POOL.length)|0]; }

async function perceive(b64, isBlot, subject){
  const instr = isBlot
    ? "This is a chance ink stain — raw material for imagination, like Leonardo gazing at a stained wall. It is NOT a drawing. Let your eye resolve it apophenically and commit to ONE concrete thing you see."
    : `This is your own evolving drawing of ${JSON.stringify(subject)}. Keep seeing it AS ${JSON.stringify(subject)} — do not switch to a different subject. Name the single part or quality you most want to develop next, still within ${JSON.stringify(subject)} (a contour, a limb, a shadow, a texture).`;
  const txt = await ask([{role:"user",content:[
    imgBlock(b64),
    {type:"text",text:`${instr} Reply ONLY as JSON: {"seen":"..."} — a SHORT evocative phrase.`}
  ]}],
  "You are the perceiving eye of an artist practicing disegno — drawing as discovery, not copying.");
  return parseJSON(txt).seen;
}

async function draft(seen, subject, blank, liftBias){
  const task = blank
    ? `The ground is an even grey. Begin pulling ${JSON.stringify(subject)} out of it: place the main MASS of shadow where its body sits, and lift a little light where it would catch.`
    : `Continue shading the SAME ${JSON.stringify(subject)}. Right now work on: ${JSON.stringify(seen)}. Deepen where the form turns into shadow; lift (like a kneaded eraser) where it catches light; blend to soften.`;
  const txt = await ask([{role:"user",content:[
    imgBlock(snapshotForModel()),
    {type:"text",text:
`You are shading with CHARCOAL on a toned grey ground (the faint grid/labels are guides only). You do NOT place precise lines — you work an AREA of tone.
${task}
Coordinates are 0-1000, origin top-left. Give 1-2 tonal moves. Each move is a soft circular region: a center (cx,cy) and radius r (try 100-300), with an operation and a strength 0-1. Precision is not needed — atmosphere is the point.
Reply ONLY as compact JSON:
{"ops":[{"op":"deepen","cx":500,"cy":400,"r":180,"strength":0.7}, {"op":"lift","cx":380,"cy":350,"r":140,"strength":0.5}], "note":"a few words"}
op is one of: "deepen" (add shadow), "lift" (reveal light), "blend" (soften).`}
  ]}],
  "You are the shading hand of an artist working in reductive charcoal: form emerges from the play of dark and light, not from outlines.");
  return parseJSON(txt);
}

// ---------- timing helpers ----------
const sleep = ms => new Promise(r=>setTimeout(r,ms));
const sc = v => Math.max(0, Math.min(1000, v))/1000*S; // model space (0-1000, clamped) -> css px

async function applyTone(ops, rate, maxSeconds, tok, liftBias){
  if(!ops || !ops.length) return;
  const interval = 1000/rate;
  const total = Math.max(10, Math.round(rate*maxSeconds));
  const deadline = performance.now()+maxSeconds*1000;
  const wsum = ops.reduce((a,o)=> a + (o.op==='blend'?0:(o.strength||0.6)), 0) || 1;
  // expand ops into an interleaved list of dabs (and blends)
  const queue=[];
  for(const o of ops){
    if(o.op==='blend'){ queue.push({blend:o}); continue; }
    const n=Math.max(4, Math.round(total*((o.strength||0.6)/wsum)));
    for(let i=0;i<n;i++) queue.push({o});
  }
  for(let i=queue.length-1;i>0;i--){ const j=(Math.random()*(i+1))|0; [queue[i],queue[j]]=[queue[j],queue[i]]; }
  for(const item of queue){
    if(tok!==abortToken || performance.now()>deadline) return;
    if(item.blend){ blendRegion(sc(item.blend.cx), sc(item.blend.cy), Math.max(20,sc(item.blend.r||150))); await sleep(interval); continue; }
    const o=item.o, cx=sc(o.cx), cy=sc(o.cy), r=Math.max(24, sc(o.r||150));
    const t=Math.random()*7, rr=Math.pow(Math.random(),0.6)*r;
    const x=cx+Math.cos(t)*rr, y=cy+Math.sin(t)*rr*(0.7+Math.random()*0.6);
    const lift = o.op==='lift';
    const a = lift ? (0.045+liftBias*0.12) : 0.075;
    dab(x, y, r*(0.16+Math.random()*0.2), lift?PAPER_RGB:CHAR_RGB, a);
    await sleep(interval);
  }
}

// ---------- the loop ----------
function addEntry(seen){
  document.querySelectorAll('.entry.live').forEach(e=>e.classList.remove('live'));
  const d=$('#drift'), el=document.createElement('div'); el.className='entry live';
  el.innerHTML=`<span class="node"></span><div class="meta">PASS ${String(round).padStart(2,'0')} / ${params().passes}</div><div class="seen">“${seen}”</div><div class="note"></div>`;
  d.appendChild(el); d.scrollTop=d.scrollHeight; return el;
}
function setPhase(t,beating){ $('#phase').textContent=t;
  const m=$('#metro'); m.classList.toggle('beat',!!beating);
  m.style.setProperty('--beat', (1000/params().rate)+'ms'); }
function log(s){ const el=$('#log'); if(el) el.textContent=s; }
function finish(){ running=false; $('#run').textContent='Begin';
  setPhase('complete · '+round+(round===1?' pass':' passes'), false); }

async function loop(){
  const tok = abortToken;
  while(running && tok===abortToken){
    const p = params();
    if(round >= p.passes){ finish(); return; }
    const firstPass = (round===0);
    const forceOffline = $('#offline') && $('#offline').checked;

    // ---- the eye ----
    setPhase((firstPass?'reading the stain':'looking')+` · ${round+1}/${p.passes}`, false);
    let seen, eyeMode='model';
    if(forceOffline){ seen=offlineSee(subject); eyeMode='offline'; }
    else{
      const stim = firstPass ? stimulusB64 : plainSnapshot();
      try{ seen = await perceive(stim, firstPass, subject); }
      catch(e){ eyeMode='offline'; window._lastErr=e.message; seen = offlineSee(subject); }
      if(!seen){ eyeMode='offline'; seen = offlineSee(subject); }
    }
    if(tok!==abortToken) return;
    if(firstPass) subject = seen;          // anchor the subject for the whole piece
    perceptMemory.push(seen);
    round++; const entry = addEntry(seen);

    // ---- the hand ----
    setPhase(`shading · ${round}/${p.passes}`, true);
    let ops=[], note='', handMode=eyeMode;
    if(eyeMode==='model'){
      try{
        const plan = await draft(seen, subject, firstPass, p.erase);
        ops = normOps(plan); note = plan.note||'';
        if(!ops.length) throw new Error('empty');
      }catch(e){ handMode='offline'; ops=[]; }
    }
    if(handMode==='offline'){ ops = offlineOps(firstPass, p.erase); }
    if(tok!==abortToken) return;

    const tally = ops.reduce((m,o)=>{ m[o.op]=(m[o.op]||0)+1; return m; },{});
    const tdesc = Object.entries(tally).map(([k,v])=>k+'×'+v).join(' ') || '—';
    log(`pass ${round} · ${handMode} · “${seen}” · ${tdesc}`
        + (handMode==='offline' && window._lastErr ? `  (model: ${window._lastErr})` : ''));
    if(note) entry.querySelector('.note').textContent='— '+note;

    await applyTone(ops, p.rate, p.time, tok, p.erase);
    if(tok!==abortToken) return;

    if(round >= p.passes){ finish(); return; }
    setPhase(`resting · ${round}/${p.passes}`, false);
    await sleep(700);
  }
}
function fail(e){
  running=false; $('#run').textContent='Begin'; $('#run').classList.add('primary');
  setPhase('halted',false);
  const box=$('#err'); box.style.display='block';
  box.textContent = (''+e).includes('API')
    ? "The eye couldn't reach the model. This needs to run as a live Claude artifact (the API is authenticated there) — it won't call out if the file is opened on its own."
    : "Lost the thread: "+e.message+". Press Begin to resume.";
  log('halted — '+e.message);
}

// ---------- wiring ----------
$('#rate').oninput=e=>{$('#rateV').textContent=e.target.value+' / s'; setPhase($('#phase').textContent, $('#metro').classList.contains('beat'));};
$('#time').oninput=e=>$('#timeV').textContent=e.target.value+' s';
$('#erase').oninput=e=>$('#eraseV').textContent=e.target.value+' %';
$('#passes').oninput=e=>$('#passesV').textContent=e.target.value;
$('#seed').onclick=()=>{ abortToken++; running=false; round=0; subject=null; perceptMemory=[];
  $('#drift').innerHTML=''; $('#err').style.display='none'; $('#run').textContent='Begin';
  newStimulus(); blankPaper(); setPhase('idle',false); };
$('#run').onclick=async ()=>{
  if(running){ running=false; abortToken++; $('#run').textContent='Resume'; setPhase('paused',false); return; }
  if(S<2 && !round) blankPaper();
  $('#err').style.display='none';
  const offline = $('#offline').checked;
  if(!offline){
    setPhase('checking the model…', false); log('checking the model…');
    const res = await probeModel();
    if(res.ok){ log('model reachable — the artist is in'); }
    else{
      const box=$('#err'); box.style.display='block';
      box.innerHTML = `<b>The model can't be reached here</b>, so every pass falls back to offline atmosphere (that's why the percept never changes). Reason: ${res.why}. Is the local server running, and is ANTHROPIC_API_KEY set in its environment? Without the model, Begin still shows the offline tonal engine.`;
      log('model unreachable — '+res.why);
    }
  }
  running=true; $('#run').textContent='Pause'; loop();
};
window.addEventListener('resize', ()=>{ if(!round){ blankPaper(); } });

// boot
newStimulus(); blankPaper(); setPhase('idle',false); log('idle — press Begin');
requestAnimationFrame(()=>{ if(!round) blankPaper(); });
window.addEventListener('load', ()=>{ if(!round) blankPaper(); });
</script>
